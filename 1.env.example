# Copy to .env and fill in. Never commit .env.

PORT=3000
# Origins allowed to call this API, comma-separated
CORS_ORIGINS=https://app.yourdomain.com,capacitor://localhost
DB_PATH=app.db

# 32+ random characters each (e.g. openssl rand -hex 32)
JWT_SECRET=
ADMIN_JWT_SECRET=
OTP_PEPPER=

# Default admin login (forced to change on first sign-in)
ADMIN_USER=admin
ADMIN_PASS=ChangeMe!2026

# ResellPortal: create the key and secret in the API section of your panel.
# Sent as the X-API-Key and X-API-Secret headers.
RP_BASE=https://panel.resellportal.com
RP_KEY=
RP_SECRET=
RP_KEY_HEADER=X-API-Key
RP_SECRET_HEADER=X-API-Secret
# 1 = validate only, nothing is created or charged (sample data). Use 0 for real.
RP_TEST_MODE=1

# Google Sign-In: comma-separated OAuth client IDs (iOS, Android, web)
GOOGLE_CLIENT_IDS=

# RevenueCat webhook: set the same value as the Authorization header in RevenueCat
RC_WEBHOOK_AUTH=

# Email (OTP codes and ticket forwarding)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TICKET_EMAIL=conrad.pm1994@gmail.com
